rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }
    
    function isValidId(id) { 
        return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { 
        return request.auth != null 
            && request.auth.token.email_verified == true; 
    }

    function isValidLeaderboardEntry(data) {
        return data.keys().hasAll(['userId', 'displayName', 'score', 'maxHeight', 'updatedAt']) 
            && data.keys().size() == 5
            && data.userId == request.auth.uid
            && data.displayName is string
            && data.displayName.size() > 0
            && data.displayName.size() <= 20
            && data.score is number
            && data.score >= 0
            && data.maxHeight is number
            && data.maxHeight >= 0
            && data.updatedAt == request.time;
    }

    match /leaderboard/{userId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() 
                    && isValidId(userId)
                    && userId == request.auth.uid
                    && isValidLeaderboardEntry(incoming());
                    
      allow update: if isSignedIn()
                    && isValidLeaderboardEntry(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'score', 'maxHeight', 'updatedAt']);
      allow delete: if isSignedIn() && userId == request.auth.uid;
    }
  }
}
